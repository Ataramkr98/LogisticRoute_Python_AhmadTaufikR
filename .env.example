# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# DJANGO_DEBUG defaults to false and DJANGO_SECRET_KEY has no default at all.
# With DEBUG off, a missing or placeholder secret raises at startup rather than
# serving with a publicly known signing key.
DJANGO_SECRET_KEY=change-me-for-local-development
DJANGO_DEBUG=true
ADMIN_MFA_REQUIRED=false
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
LOG_LEVEL=INFO

# Default rows per page on list endpoints. Clients may request up to 200.
API_PAGE_SIZE=50

# ---------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS)
# ---------------------------------------------------------------------------
# The application always uses the PostGIS backend; a plain PostgreSQL server is
# not sufficient because the schema stores geometry columns with GiST indexes.
#
# Option 1 - a single connection URL. This is what managed providers hand you
# (Neon, Railway, Supabase, RDS, Docker Compose) and it takes precedence over
# the individual DATABASE_* settings below. Append `?sslmode=require` for any
# provider that enforces TLS. Neon's pooled endpoint also needs the channel
# binding parameter shown in its dashboard.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option 2 - discrete settings, used when DATABASE_URL is unset.
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_SSLMODE=prefer
DATABASE_CONN_MAX_AGE=60
TEST_DATABASE_NAME=test_logistics

# ---------------------------------------------------------------------------
# GeoDjango native libraries (Windows only)
# ---------------------------------------------------------------------------
# GeoDjango needs GDAL, GEOS and the PROJ coordinate database. On Linux and
# macOS the system packages are discovered automatically and these can stay
# empty. On Windows set them to the paths inside the `rasterio` wheel:
#   GDAL_LIBRARY_PATH=C:/path/to/site-packages/rasterio.libs/gdal-<hash>.dll
#   GEOS_LIBRARY_PATH=C:/path/to/site-packages/rasterio.libs/geos_c-<hash>.dll
#
# PROJ_LIB points at the directory holding proj.db and is normally detected
# automatically from the same wheel. Set it by hand only if reprojection
# reports "Cannot find proj.db":
#   PROJ_LIB=C:/path/to/site-packages/rasterio/proj_data
#
# A missing proj.db does not stop the app from serving: ordinary spatial queries
# still work because PostGIS does that math in the database. Only converting a
# geometry between SRIDs in Python fails, which is easy to miss while testing
# locally and much harder to diagnose later.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=
PROJ_LIB=

# ---------------------------------------------------------------------------
# Cache and task queue
# ---------------------------------------------------------------------------
# Redis is an optional accelerator, and every consumer tolerates its absence:
#   cache      -> rate limiting degrades open (fail-open on purpose)
#   broker     -> apps.common.dispatch.dispatch runs the task inline
#   SSE        -> the progress page falls back to polling
#   readiness  -> reports "degraded" but still returns 200
# With no Redis running you do not need to change anything below. CACHES follows
# REDIS_URL automatically when DEBUG is off; leave CACHE_BACKEND set to LocMem
# for local work so the test suite never depends on a running server.
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=routeops
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_TIME_LIMIT=600
# true runs tasks in the request instead of queueing them. Correct whenever no
# worker is running; set it to false only when `celery -A config worker` is up.
CELERY_TASK_ALWAYS_EAGER=true

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Unset, mail is printed to the log, so a fresh checkout needs no SMTP account.
# For a real deployment point these at your provider.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=RouteOps <no-reply@example.com>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true

# ---------------------------------------------------------------------------
# Maps, geocoding and routing
# ---------------------------------------------------------------------------
# `fake` providers answer from bundled fixtures, so the whole planning pipeline
# runs offline with no API keys. Switch to a real provider for live data.
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
GEOCODING_PROVIDER=fake
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=logistics-route-optimization-local/1.0
ROUTING_PROVIDER=fake
ROUTING_BASE_URL=https://router.project-osrm.org

# ---------------------------------------------------------------------------
# Optimization
# ---------------------------------------------------------------------------
SOLVER_TIME_LIMIT_SECONDS=30
MAX_ORDERS_PER_RUN=1000

# ---------------------------------------------------------------------------
# Data retention
# ---------------------------------------------------------------------------
GPS_RETENTION_DAYS=90
POD_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Symmetric key used to encrypt driver and customer PII at rest. It falls back
# to DJANGO_SECRET_KEY when blank, which is convenient locally but couples two
# concerns: rotating either one makes every existing ciphertext undecryptable,
# and apps.common.fields raises rather than silently returning an empty value.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Error reporting (optional)
# ---------------------------------------------------------------------------
# sentry-sdk is a dependency but is only initialised when SENTRY_DSN is set, so
# a copied .env file cannot ship local stack traces to someone else's project.
# Request bodies are excluded (send_default_pii=False): they carry customer
# addresses and driver PII.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
# SENTRY_RELEASE=
