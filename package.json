{
  "name": "logistics-route-optimization",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "npm run build:css && npm run build:assets && npm run build:js",
    "build:assets": "node ./scripts/copy-static-assets.mjs",
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./static/build/app.css --minify",
    "build:js": "esbuild ./assets/js/app.js --bundle --minify --outfile=./static/build/app.js",
    "watch:css": "tailwindcss -i ./assets/css/app.css -o ./static/build/app.css --watch",
    "watch:js": "esbuild ./assets/js/app.js --bundle --sourcemap --outfile=./static/build/app.js --watch",
    "test:e2e": "playwright test tests/e2e"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.15.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tabler/icons-webfont": "^3.46.0",
    "@tailwindcss/cli": "^4.1.18",
    "alpinejs": "^3.15.3",
    "chart.js": "^4.5.1",
    "htmx.org": "^2.0.8",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "sortablejs": "^1.15.6",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "esbuild": "^0.27.2"
  }
}
